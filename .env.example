# ── Bermakna Enterprise — salin berkas ini menjadi .env lalu isi nilainya ──
# Semua nilai diambil dari dashboard proyek Supabase.
# Panduan langkah demi langkah ada di README, bagian "Menyiapkan Supabase".

# ── 1) Database ────────────────────────────────────────────────────────────
# Dashboard proyek ▸ tombol "Connect" ▸ tab ORMs ▸ pilih Prisma.
# Ganti [YOUR-PASSWORD] dengan sandi database yang kamu buat saat membuat proyek.
#
#   DATABASE_URL  → Transaction pooler, port 6543 (dipakai aplikasi)
#   DIRECT_URL    → Session pooler,     port 5432 (dipakai Prisma saat migrasi)
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── 2) Storage ─────────────────────────────────────────────────────────────
# Dashboard proyek ▸ Settings ▸ API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"

# RAHASIA — kunci ini mengabaikan seluruh Row Level Security, jadi hanya boleh
# dipakai di sisi server. Jangan pernah di-commit atau dikirim di grup chat.
#
# Ambil dari Settings ▸ API Keys ▸ bagian "Secret keys" (diawali sb_secret_).
# Kunci service_role lama berformat JWT (diawali eyJ) juga masih diterima,
# tetapi dipensiunkan Supabase akhir 2026 — pakai yang baru untuk proyek baru.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"

# ── 3) Kunci penandatangan cookie sesi ─────────────────────────────────────
# Buat nilai baru dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-32-byte"
