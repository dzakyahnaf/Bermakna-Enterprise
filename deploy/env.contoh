# ─────────────────────────────────────────────────────────────────────────
# Contoh /opt/bermakna/.env di server produksi. JANGAN di-commit.
# Salin ke server, isi, lalu:  chmod 600 /opt/bermakna/.env
#
# Buat nilai acak dengan:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Sandi database. Hanya huruf/angka (hex) — dipakai di dalam URL koneksi.
POSTGRES_PASSWORD=

# Kunci penandatangan cookie sesi dan tautan berkas privat. Mengganti nilainya
# membuat semua pengguna ter-logout.
SESSION_SECRET=

# Alamat kanonis situs (tanpa garis miring di akhir).
NEXT_PUBLIC_SITE_URL=https://maknaprice.my.id

# Hanya sebelum DNS diarahkan ke server: layani lewat http://IP untuk pengujian.
# Hapus baris ini setelah DNS pindah, lalu deploy ulang.
# CADDY_CONFIG=Caddyfile.pra-dns

# Nyalakan /api/diagnostik sementara saat menelusuri masalah (1 = nyala).
# DIAGNOSTIK=1
